# Extras under apps/, as the `apps` module of the root justfile: `just apps <recipe>`.
# Paths are relative to this file, so it also works from apps/.

[private]
default:
    @just --justfile {{ source_file() }} --list

# Run the read-only desktop console (spike) against the signer's config; paths resolve from where you run it
[no-cd]
[positional-arguments]
console *args:
    cargo run --locked --manifest-path {{ source_directory() }}/console/Cargo.toml -- "$@"

# The console's own gate: fmt, clippy (warnings are errors), tests, advisories, dependency age
console-check:
    {{ source_directory() }}/../scripts/ci/app-check.sh console

# Install GPUI Kit's Claude skills at the console's gpui-kit version (default ~/.claude/skills; --project, --uninstall)
[positional-arguments]
gpui-kit-skills *args:
    {{ source_directory() }}/../scripts/skills/gpui-kit.sh "$@"

# Serve the grant page on http://127.0.0.1:8791 (needs trunk and the wasm32-unknown-unknown target)
grant:
    cd {{ source_directory() }}/grant && trunk serve --release --locked

# The grant page's own gate: fmt, clippy on host and wasm (warnings are errors), tests, advisories, dependency age
grant-check:
    {{ source_directory() }}/../scripts/ci/app-check.sh grant

# Write the signer's instruction table from Codama IDL files (never copies them): --cluster, --from, --out, then the IDLs
[no-cd]
[positional-arguments]
idl-table *args:
    cargo run --locked --manifest-path {{ source_directory() }}/idl-table/Cargo.toml -- "$@"

# The IDL table generator's own gate: fmt, clippy (warnings are errors), tests, advisories, dependency age
idl-table-check:
    {{ source_directory() }}/../scripts/ci/app-check.sh idl-table
